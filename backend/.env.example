# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=civic_issues

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# App
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
COOKIE_NAME=civic_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_DAYS=7

# Logging / proxy
TRUST_PROXY=1
LOG_LEVEL=info
LOG_PRETTY=true
SERVICE_NAME=civic-issues-api
SERVICE_VERSION=1.0.0

# Initial accounts (only created when their email does not already exist)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change_me_owner_password
OFFICER_EMAIL=officer@example.com
OFFICER_PASSWORD=change_me_officer_password
ENABLE_DEMO_ACCOUNTS=true
DEMO_CITIZEN_EMAIL=citizen@janasahaya.demo
DEMO_ADMIN_EMAIL=admin@janasahaya.demo
DEMO_PASSWORD=change_me_public_demo_password
