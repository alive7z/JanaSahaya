# Frontend environment variables (Vite — must be prefixed with VITE_).
# On Vercel these are set in Project Settings → Environment Variables.
# Copy to frontend/.env for local overrides only.

# Backend API base URL on Render. Include the /api/v1 suffix.
VITE_API_URL=https://janasahaya-api.onrender.com/api/v1

# Socket.IO origin (the Render backend origin, without /api/v1).
VITE_SOCKET_URL=https://janasahaya-api.onrender.com

# Uploaded media base (optional). Defaults to "<backend origin>/uploads".
# VITE_MEDIA_URL=https://janasahaya-api.onrender.com/uploads

# Demo accounts. The demo credentials are intentionally public.
VITE_ENABLE_DEMO_ACCOUNTS=true
VITE_DEMO_CITIZEN_EMAIL=citizen@janasahaya.demo
VITE_DEMO_ADMIN_EMAIL=admin@janasahaya.demo
VITE_DEMO_PASSWORD=your_public_demo_password
