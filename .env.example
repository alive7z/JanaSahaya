# Copy to .env and replace every CHANGE_ME value before deployment.
# Generate independent secrets with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_database_password
DB_NAME=civic_issues
DB_USER=janasetu
DB_PASSWORD=CHANGE_ME_application_database_password

JWT_ACCESS_SECRET=CHANGE_ME_independent_64_character_random_value
JWT_REFRESH_SECRET=CHANGE_ME_different_64_character_random_value

# Exact browser-visible origin; no trailing slash.
CLIENT_ORIGIN=https://janasahaya.example.com
FRONTEND_PORT=8080

COOKIE_NAME=civic_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_MAX_AGE_DAYS=7

MAX_UPLOAD_MB=8
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REGISTER_MAX=5

# Owner credentials are used only when the account does not already exist.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_owner_password_at_least_12_characters
OFFICER_EMAIL=officer@example.com
OFFICER_PASSWORD=CHANGE_ME_officer_password_at_least_12_characters

# Demo credentials are intentionally delivered to the public frontend bundle.
# The demo admin is restricted from user/system mutations by the API.
ENABLE_DEMO_ACCOUNTS=true
DEMO_CITIZEN_EMAIL=citizen@janasahaya.demo
DEMO_ADMIN_EMAIL=admin@janasahaya.demo
DEMO_PASSWORD=CHANGE_ME_public_demo_password
