# ─────────────────────────────────────────────────────────────────────────────
# JanaSahaya backend environment
# Local development: copy to backend/.env and keep the defaults below.
# Render: set these as Web Service environment variables (never commit values).
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=4000
SERVICE_NAME=janasahaya-api
SERVICE_VERSION=1.0.0
TRUST_PROXY=1
LOG_LEVEL=info
LOG_PRETTY=false

# Aiven MySQL (TLS required). For local MySQL leave DB_SSL_CA_PATH empty.
DB_HOST=your_aiven_host
DB_PORT=your_aiven_port
DB_USER=your_aiven_user
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
# Path to the Aiven CA certificate. On Render use the secret file path below.
DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem
# Keep this small on the Render free instance.
DB_POOL_SIZE=5

# JWT (two independent random values, at least 32 characters). Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=your_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — exact browser origin(s) of the frontend. Comma-separated is supported.
# Vercel: https://janasahaya.vercel.app   Local: http://localhost:5173
CLIENT_ORIGIN=https://janasahaya.vercel.app

# Refresh cookie. Cross-site (Vercel → Render) requires sameSite=none + secure=true.
COOKIE_NAME=civic_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
COOKIE_MAX_AGE_DAYS=7

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REGISTER_MAX=5

# Uploads (ephemeral on Render — see README > Deployment).
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8

# Initial accounts (created only when their email does not already exist).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=your_owner_password_at_least_12_chars
OFFICER_EMAIL=officer@example.com
OFFICER_PASSWORD=your_officer_password_at_least_12_chars

# Demo accounts (public recruiter logins).
ENABLE_DEMO_ACCOUNTS=true
DEMO_CITIZEN_EMAIL=citizen@janasahaya.demo
DEMO_ADMIN_EMAIL=admin@janasahaya.demo
DEMO_PASSWORD=your_public_demo_password
